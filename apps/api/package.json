{
  "name": "@gc3/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --packages=external --sourcemap --outfile=dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/prepare-test-db.mjs && vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed:tiers": "tsx scripts/seed-tiers.ts",
    "db:studio": "prisma studio",
    "auth:bootstrap": "tsx scripts/create-platform-admin.ts",
    "start:prod": "node dist/index.js",
    "release": "prisma migrate deploy && tsx scripts/seed-pods.ts && tsx scripts/seed-tiers.ts",
    "db:seed:pods": "tsx scripts/seed-pods.ts",
    "build:vercel": "esbuild src/serverless.ts --bundle --platform=node --target=node22 --format=esm --outfile=api/index.mjs --external:pg-native --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "vercel:output": "node scripts/prepare-vercel-output.mjs"
  },
  "dependencies": {
    "@gc3/types": "workspace:*",
    "@gc3/validation": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bullmq": "^6.6.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.15",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "prisma": "7.10.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
