# apps/api environment contract — copy to .env
NODE_ENV=development
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000

# PostgreSQL (Podman: postgres:16 on 5432)
DATABASE_URL=postgresql://gc3:gc3@localhost:5432/gc3_portal?schema=public
# Integration-test database — created and migrated by scripts/prepare-test-db.mjs
TEST_DATABASE_URL=postgresql://gc3:gc3@localhost:5432/gc3_portal_test?schema=public

# Auth — AUTH_SECRET must be at least 32 characters and unique per environment
AUTH_SECRET=replace-with-a-32-plus-character-random-secret
AUTH_ISSUER=gc3-portal
AUTH_AUDIENCE=gc3-api
AUTH_TOKEN_TTL_SECONDS=900

# Invitations
INVITE_TTL_HOURS=168
WEB_APP_URL=http://localhost:3000
# Delivery driver: console | memory | noop | failing | smtp
# console (prints the accept URL) and failing are REFUSED in production.
# Production default when unset is "noop" — configure a real provider there.
NOTIFICATION_DRIVER=console

# SMTP relay (required when NOTIFICATION_DRIVER=smtp).
# Local sink for development and tests (Podman):
#   podman run -d --name gc3-mailpit -p 1025:1025 -p 8025:8025 axllent/mailpit
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM=GC3 Portal <no-reply@gc3.local>
