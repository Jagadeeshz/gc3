// GC3 Portal — identity & tenancy schema (Development Brief §9, Phase 1 slice 1).
//
// Tenancy rule: every tenant-owned record carries an explicit organizationId.
// Users are global identities; access to a tenant is granted only through a
// Membership, which is the record that binds a user to one organization.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums — storage representation of the contracts in @gc3/types
// ---------------------------------------------------------------------------

enum OrganizationStatus {
  PROSPECT
  ONBOARDING
  ACTIVE
  SUSPENDED
  CHURNED
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  REVOKED
}

/// Internal work item: how a request is broken down inside the pod. Never shown
/// to clients.
enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

/// Roles held inside a tenant. Client-side only.
enum ClientRole {
  CLIENT_OWNER
  CLIENT_TEAM_MEMBER
  CLIENT_APPROVER
}

/// GC3 internal roles. Global, never tenant-attached: staff act across tenants
/// through assignment and platform duty, not membership.
enum StaffRole {
  PLATFORM_ADMIN
  OPERATIONS_MANAGER
  ACCOUNT_MANAGER
  POD_MANAGER
  SPECIALIST
  FINANCE_MANAGER
}

enum ActorType {
  USER
  AI_AGENT
  SYSTEM
}

/// What triggered a notification.
enum NotificationKind {
  INVITATION
  RESENT
  DELIVERABLE_RELEASED
  REQUEST_STATUS_UPDATED
  SLA_RISK
}

/// Outcome of a delivery attempt. SKIPPED is a real state: a noop driver has
/// not sent anything, and recording it as SENT would falsify the audit trail.
enum NotificationStatus {
  SENT
  FAILED
  SKIPPED
}

// ---------------------------------------------------------------------------
// Phase 2 — client portal & service requests (Development Brief §5.2, §9)
// ---------------------------------------------------------------------------

/// Service request lifecycle.
enum ServiceRequestStatus {
  DRAFT
  SUBMITTED
  TRIAGE
  IN_PROGRESS
  BLOCKED
  IN_REVIEW
  DELIVERED
  CLOSED
  CANCELLED
}

enum ServiceRequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// Deliverable lifecycle (§5.4). RELEASED is terminal and requires human
/// sign-off — an AI actor may never set it (see AGENT_PROHIBITED_ACTIONS).
enum DeliverableStatus {
  PENDING
  IN_PROGRESS
  IN_REVIEW
  APPROVED
  REJECTED
  RELEASED
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model Organization {
  id        String             @id @default(uuid()) @db.Uuid
  name      String             @db.VarChar(120)
  slug      String             @unique @db.VarChar(60)
  status    OrganizationStatus @default(PROSPECT)
  timezone  String             @default("Asia/Kolkata") @db.VarChar(64)
  region    String             @default("global") @db.VarChar(64)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime?          @map("deleted_at") @db.Timestamptz(3)

  memberships Membership[]
  auditEvents AuditEvent[]
  notifications NotificationDelivery[]
  serviceCategories ServiceCategory[]
  serviceRequests ServiceRequest[]
  requestComments RequestComment[]
  deliverables Deliverable[]
  deliverableVersions DeliverableVersion[]
  pods Pod[]
  podMembers PodMember[]
  tasks Task[]
  subscription      OrganizationSubscription?
  invoices          Invoice[]
  invoiceLineItems  InvoiceLineItem[]
  usageMeters       UsageMeter[]

  @@index([status])
  @@index([createdAt])
  @@map("organizations")
}

model User {
  id         String     @id @default(uuid()) @db.Uuid
  email      String     @unique @db.VarChar(254)
  fullName   String     @map("full_name") @db.VarChar(120)
  status     UserStatus @default(INVITED)

  /// scrypt digest. Null for invited users who have not yet set a password —
  /// such a user cannot authenticate at all.
  passwordHash String? @map("password_hash")

  /// Present only for GC3 staff. Client users have no platform role.
  platformRole StaffRole? @map("platform_role")

  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(3)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt  DateTime?  @map("deleted_at") @db.Timestamptz(3)

  memberships Membership[]
  notifications NotificationDelivery[]

  requestsRequested  ServiceRequest[]  @relation("ServiceRequestRequester")
  requestsAssigned   ServiceRequest[]  @relation("ServiceRequestAssignee")
  requestComments    RequestComment[]  @relation("RequestCommentAuthor")
  deliverablesApproved Deliverable[]   @relation("DeliverableApprover")
  deliverablesCreated  Deliverable[]   @relation("DeliverableCreator")
  deliverableVersions  DeliverableVersion[] @relation("DeliverableVersionAuthor")
  podsLed              Pod[]             @relation("PodLead")
  podMemberships       PodMember[]       @relation("PodMemberUser")
  tasksAssigned        Task[]            @relation("TaskAssignee")
  tasksCreated         Task[]            @relation("TaskCreator")
  invoicesPaid         Invoice[]         @relation("InvoicePaidBy")
  invoicesCreated      Invoice[]         @relation("InvoiceCreatedBy")

  @@index([status])
  @@index([platformRole])
  @@map("users")
}

/// Binds a user to exactly one organization with one or more client roles.
/// This is the tenant boundary: no ACTIVE membership, no tenant access.
model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  roles          ClientRole[]
  status         MembershipStatus @default(INVITED)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// SHA-256 of the one-time invite token. Only the hash is stored, so a
  /// database leak does not yield a working invite link. Cleared on acceptance.
  inviteTokenHash      String?   @unique @map("invite_token_hash") @db.VarChar(64)
  inviteTokenExpiresAt DateTime? @map("invite_token_expires_at") @db.Timestamptz(3)
  inviteAcceptedAt     DateTime? @map("invite_accepted_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  notifications NotificationDelivery[]

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("memberships")
}

/// Append-only record of consequential actions (Development Brief §12).
/// organizationId is nullable for platform-level events that belong to no tenant.
model AuditEvent {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  actorType      ActorType @map("actor_type")
  actorId        String?   @map("actor_id") @db.Uuid
  action         String    @db.VarChar(80)
  targetType     String?   @map("target_type") @db.VarChar(60)
  targetId       String?   @map("target_id") @db.VarChar(60)
  metadata       Json?
  /// Request context, so a security review can tie a change to an HTTP call.
  ip             String?   @db.VarChar(64)
  userAgent      String?   @map("user_agent") @db.VarChar(300)
  requestId      String?   @map("request_id") @db.VarChar(64)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([action])
  @@index([createdAt])
  @@map("audit_events")
}

/// Permanent record of every notification delivery attempt (Development Brief
/// §12 auditability, §14 notifications).
///
/// This is deliberately separate from AuditEvent: an audit event records a
/// *business* action, while this records what happened when we tried to tell
/// someone about it — including failures, which is the part that silently
/// disappears in most systems.
model NotificationDelivery {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  /// Null for event notifications, which go to a person, not a membership row.
  membershipId   String?            @map("membership_id") @db.Uuid
  userId         String             @map("user_id") @db.Uuid
  kind           NotificationKind
  /// Event subjects — what makes an event email rebuildable on retry.
  subjectRequestId     String?      @map("subject_request_id") @db.Uuid
  subjectDeliverableId String?      @map("subject_deliverable_id") @db.Uuid
  channel        String             @default("email") @db.VarChar(20)
  driver         String             @db.VarChar(40)
  status         NotificationStatus
  recipient      String             @db.VarChar(254)
  messageId      String?            @map("message_id") @db.VarChar(120)
  /// Provider or transport error, truncated to keep the row compact.
  error          String?            @db.VarChar(500)
  /// 1 for the original attempt, incrementing per retry in the chain.
  attempt        Int                @default(1)
  /// Set while a failed attempt is still scheduled for another try.
  nextAttemptAt  DateTime?          @map("next_attempt_at") @db.Timestamptz(3)
  lastAttemptAt  DateTime?          @map("last_attempt_at") @db.Timestamptz(3)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   Membership?  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectRequest     ServiceRequest? @relation("NotificationSubjectRequest", fields: [subjectRequestId], references: [id], onDelete: SetNull)
  subjectDeliverable Deliverable?    @relation("NotificationSubjectDeliverable", fields: [subjectDeliverableId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([membershipId])
  @@index([userId])
  @@index([status])
  @@index([status, nextAttemptAt])
  @@map("notification_deliveries")
}

// ---------------------------------------------------------------------------
// Phase 2 — Client portal data model
//
// Tenancy rule holds without exception here: all four tables carry a required
// organizationId, are indexed on it, and are only ever read through a
// scope-first repository method. There is no "global" row that a query could
// accidentally blend into a tenant's result.
// ---------------------------------------------------------------------------

/// A service a tenant can request work under (Development Brief §6.2).
model ServiceCategory {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.VarChar(120)
  slug           String    @db.VarChar(60)
  description    String?                 @db.VarChar(500)
  isActive       Boolean                 @default(true) @map("is_active")
  /// Service-specific delivery commitment in hours. Null falls back to the
  /// priority default in lib/sla.ts.
  slaDeliveryHours Int?                  @map("sla_delivery_hours")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requests     ServiceRequest[]

  @@unique([organizationId, slug])
  @@index([organizationId, isActive])
  @@map("service_categories")
}

/// A client request for work (Development Brief §5.2, §9).
model ServiceRequest {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @map("organization_id") @db.Uuid
  /// Human-facing reference, unique per tenant: REQ-3F2A91BC.
  reference      String                  @db.VarChar(24)
  categoryId     String?                 @map("category_id") @db.Uuid
  title          String                  @db.VarChar(200)
  description    String                  @db.Text
  status         ServiceRequestStatus    @default(DRAFT)
  priority       ServiceRequestPriority  @default(NORMAL)
  requesterId    String                  @map("requester_id") @db.Uuid
  assigneeId     String?                 @map("assignee_id") @db.Uuid
  podId          String?                 @map("pod_id") @db.Uuid
  dueAt          DateTime?               @map("due_at") @db.Timestamptz(3)
  /// Materialised SLA commitment: createdAt + the service or priority hours.
  slaTargetAt    DateTime?               @map("sla_target_at") @db.Timestamptz(3)
  /// Last risk state an alert was sent for, so a sweep does not repeat itself.
  slaAlertedState String?                @map("sla_alerted_state") @db.VarChar(20)
  slaAlertedAt   DateTime?               @map("sla_alerted_at") @db.Timestamptz(3)
  submittedAt    DateTime?               @map("submitted_at") @db.Timestamptz(3)
  closedAt       DateTime?               @map("closed_at") @db.Timestamptz(3)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?               @map("deleted_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  requester    User             @relation("ServiceRequestRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  assignee     User?            @relation("ServiceRequestAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  pod          Pod?             @relation(fields: [podId], references: [id], onDelete: SetNull)
  notifications NotificationDelivery[] @relation("NotificationSubjectRequest")
  comments     RequestComment[]
  deliverables Deliverable[]
  tasks        Task[]

  @@unique([organizationId, reference])
  @@index([organizationId, status])
  @@index([podId])
  @@index([organizationId, createdAt])
  @@index([organizationId, requesterId])
  @@index([categoryId])
  @@map("service_requests")
}

/// A message on a request. isInternal marks staff-only notes the client never
/// sees — the API layer must filter, the schema records the intent.
model RequestComment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  requestId      String   @map("request_id") @db.Uuid
  authorId       String   @map("author_id") @db.Uuid
  body           String   @db.Text
  isInternal     Boolean  @default(false) @map("is_internal")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  request      ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author       User           @relation("RequestCommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([organizationId, requestId, createdAt])
  @@map("request_comments")
}

/// An output delivered against a request (Development Brief §5.4).
model Deliverable {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  requestId      String?           @map("request_id") @db.Uuid
  title          String            @db.VarChar(200)
  description    String?           @db.VarChar(1000)
  status         DeliverableStatus @default(PENDING)
  version        Int               @default(1)
  fileUrl        String?           @map("file_url") @db.VarChar(500)
  fileKey        String?           @map("file_key") @db.VarChar(300)
  fileSha256     String?           @map("file_sha256") @db.VarChar(64)
  fileSize       Int?              @map("file_size")
  fileMimeType   String?           @map("file_mime_type") @db.VarChar(120)
  createdById    String?           @map("created_by_id") @db.Uuid
  approvedById   String?           @map("approved_by_id") @db.Uuid
  approvedAt     DateTime?         @map("approved_at") @db.Timestamptz(3)
  releasedAt     DateTime?         @map("released_at") @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?         @map("deleted_at") @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  request      ServiceRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  createdBy    User?           @relation("DeliverableCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy   User?           @relation("DeliverableApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  notifications NotificationDelivery[] @relation("NotificationSubjectDeliverable")
  versions     DeliverableVersion[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([requestId])
  @@index([createdById])
  @@map("deliverables")
}

/**
 * Every version of a deliverable's content, append-only. The deliverable row
 * carries the current snapshot; these rows are how "what did we actually hand
 * over in v2" stays answerable after a replacement.
 */
model DeliverableVersion {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  deliverableId  String   @map("deliverable_id") @db.Uuid
  version        Int
  title          String   @db.VarChar(200)
  description    String?  @db.VarChar(1000)
  fileUrl        String?  @map("file_url") @db.VarChar(500)
  fileKey        String?  @map("file_key") @db.VarChar(300)
  fileSha256     String?  @map("file_sha256") @db.VarChar(64)
  fileSize       Int?     @map("file_size")
  fileMimeType   String?  @map("file_mime_type") @db.VarChar(120)
  createdById    String?  @map("created_by_id") @db.Uuid
  changeNote     String?  @map("change_note") @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliverable  Deliverable  @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("DeliverableVersionAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([deliverableId, version])
  @@index([organizationId, createdAt])
  @@map("deliverable_versions")
}

/// Internal work item carved out of a request for a pod member.
model Task {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  requestId      String     @map("request_id") @db.Uuid
  podId          String?    @map("pod_id") @db.Uuid
  assigneeId     String?    @map("assignee_id") @db.Uuid
  createdById    String?    @map("created_by_id") @db.Uuid
  title          String     @db.VarChar(200)
  description    String?    @db.VarChar(2000)
  status         TaskStatus @default(TODO)
  dueAt          DateTime?  @map("due_at") @db.Timestamptz(3)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?  @map("deleted_at") @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  request      ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  pod          Pod?           @relation(fields: [podId], references: [id], onDelete: SetNull)
  assignee     User?          @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy    User?          @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, requestId])
  @@index([organizationId, assigneeId])
  @@index([podId])
  @@map("tasks")
}

/// The standing delivery team inside one tenant. Pods never span organizations.
model Pod {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.VarChar(120)
  slug           String    @db.VarChar(60)
  description    String?   @db.VarChar(500)
  leadId         String?   @map("lead_id") @db.Uuid
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         User?         @relation("PodLead", fields: [leadId], references: [id], onDelete: SetNull)
  members      PodMember[]
  requests     ServiceRequest[]
  tasks        Task[]

  @@unique([organizationId, slug])
  @@index([organizationId, isActive])
  @@map("pods")
}

/// Membership of a person in a pod. Unique per (pod, user).
model PodMember {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  podId          String   @map("pod_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pod          Pod          @relation(fields: [podId], references: [id], onDelete: Cascade)
  user         User         @relation("PodMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([podId, userId])
  @@index([organizationId])
  @@map("pod_members")
}

// ---------------------------------------------------------------------------
// Phase 4 — Finance: subscriptions, usage metering and invoicing
//
// Money is stored as integer minor units (paisa/cents) everywhere. There is no
// float in this section: an invoice that rounds differently on two machines is
// not an invoice.
//
// Tenancy: every tenant-owned row here carries organizationId. SubscriptionTier
// is the deliberate exception — tiers are the platform's price list, identical
// for every tenant, so they are global catalogue rows, not tenant data.
// ---------------------------------------------------------------------------

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  VOID
}

enum InvoiceLineItemKind {
  TIER_FEE
  USAGE
  ADJUSTMENT
}

/// What is being metered. Storage is counted in KB so the counter stays in an
/// integer range that comfortably covers terabytes.
enum UsageMeterKey {
  REQUESTS
  STORAGE_KB
  API_CALLS
}

/// The platform's price list. Global by design: every tenant sees the same tiers.
model SubscriptionTier {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(40)
  name        String  @db.VarChar(80)
  description String? @db.VarChar(500)

  monthlyPriceCents Int    @map("monthly_price_cents")
  currency          String @default("INR") @db.VarChar(3)

  /// Included allowances for one billing period.
  requestsIncluded  Int @default(0) @map("requests_included")
  storageMbIncluded Int @default(0) @map("storage_mb_included")
  apiCallsIncluded  Int @default(0) @map("api_calls_included")
  seatsIncluded     Int @default(0) @map("seats_included")

  /// Overage unit prices, in minor units.
  requestOverageCents       Int @default(0) @map("request_overage_cents")
  storageMbOverageCents     Int @default(0) @map("storage_mb_overage_cents")
  apiCallsOverageCentsPer1k Int @default(0) @map("api_calls_overage_cents_per_1k")

  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  subscriptions OrganizationSubscription[]

  @@index([isActive, sortOrder])
  @@map("subscription_tiers")
}

/// One current subscription per tenant. History lives in the invoices, which
/// snapshot the tier they were billed for.
model OrganizationSubscription {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @unique @map("organization_id") @db.Uuid
  tierId         String             @map("tier_id") @db.Uuid
  status         SubscriptionStatus @default(ACTIVE)

  currentPeriodStart DateTime @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd   DateTime @map("current_period_end") @db.Timestamptz(3)

  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tier         SubscriptionTier   @relation(fields: [tierId], references: [id], onDelete: Restrict)

  @@index([tierId])
  @@map("organization_subscriptions")
}

/// A bill. Generation produces DRAFT; issuing and settling are human finance
/// actions (see finance:manage and the notes in PROGRESS).
model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  /// Per-tenant sequence: INV-2026-11-0001.
  number         String        @db.VarChar(40)
  status         InvoiceStatus @default(DRAFT)

  periodStart DateTime @map("period_start") @db.Timestamptz(3)
  periodEnd   DateTime @map("period_end") @db.Timestamptz(3)

  currency      String @default("INR") @db.VarChar(3)
  subtotalCents Int    @map("subtotal_cents")
  taxCents      Int    @default(0) @map("tax_cents")
  totalCents    Int    @map("total_cents")

  notes String? @db.VarChar(500)

  issuedAt     DateTime? @map("issued_at") @db.Timestamptz(3)
  dueAt        DateTime? @map("due_at") @db.Timestamptz(3)
  paidAt       DateTime? @map("paid_at") @db.Timestamptz(3)
  paidByUserId String?   @map("paid_by_user_id") @db.Uuid
  voidedAt     DateTime? @map("voided_at") @db.Timestamptz(3)
  createdById  String?   @map("created_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  paidBy       User?          @relation("InvoicePaidBy", fields: [paidByUserId], references: [id], onDelete: SetNull)
  createdBy    User?          @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lineItems    InvoiceLineItem[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([status, dueAt])
  @@map("invoices")
}

model InvoiceLineItem {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  invoiceId      String              @map("invoice_id") @db.Uuid
  kind           InvoiceLineItemKind
  description    String              @db.VarChar(200)

  quantity        Int
  unitAmountCents Int @map("unit_amount_cents")
  amountCents     Int @map("amount_cents")

  /// Which meter produced this line, when it came from usage.
  meterKey String? @map("meter_key") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_line_items")
}

/// One counter per tenant, meter and period. Upserted on every metered event.
model UsageMeter {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  key            UsageMeterKey
  /// Billing period as YYYY-MM.
  period         String        @db.VarChar(7)
  quantity       Int           @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key, period])
  @@index([organizationId, period])
  @@map("usage_meters")
}
