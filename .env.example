# ---------------------------------------------------------------------------
# GC3 Portal — local development environment
# Copy to .env (never commit .env) and fill in real values.
# ---------------------------------------------------------------------------

# API (apps/api)
NODE_ENV=development
API_PORT=3001
API_HOST=0.0.0.0

# Web (apps/web)
# Browser-facing API base URL used by the Next.js client
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
# Server-side API base URL (container / internal network in deployed envs)
API_INTERNAL_BASE_URL=http://localhost:3001/api/v1

# PostgreSQL — Phase 1 onboarding of Prisma
DATABASE_URL=postgresql://gc3:gc3@localhost:5432/gc3_portal?schema=public

# Redis — queue / cache (Phase 3+)
REDIS_URL=redis://localhost:6379

# Auth provider (Phase 1) — do not commit secrets
AUTH_SECRET=replace-me
